# ============================================================
# Exemplo de variáveis para deploy na Vercel
# ============================================================
# Copie esses valores no painel da Vercel:
#   Project → Settings → Environment Variables
#
# NUNCA commite um arquivo .env real com senhas.

# Postgres (obrigatório). Use a connection string do Neon, Supabase,
# Railway ou qualquer Postgres acessível pela internet.
#
# IMPORTANTE (Neon): use a string SEM "-pooler" no host. A string com
# pooler/pgbouncer pode falhar no `prisma migrate deploy` durante o build.
# Exemplo Neon correto:
#   postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
#
# Se a string do Neon vier com ?channel_binding=require, pode manter ou
# remover, mas ?sslmode=require é obrigatório na Vercel.
DATABASE_URL="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth (obrigatório em produção).
# Gere um segredo forte com:
#   openssl rand -base64 32
# SEM ESSE VALOR O LOGIN FALHA NA VERCEL.
NEXTAUTH_SECRET="coloque_aqui_um_hash_aleatorio_32_bytes_ou_mais"

# URL exata do site na Vercel (com https e sem barra no final).
# Só é necessária se usar dominio customizado. Para previews/branches,
# deixe em branco para o NextAuth usar VERCEL_URL automaticamente.
NEXTAUTH_URL=""

# Redis / Upstash / Vercel KV (opcional). O app funciona sem, mas fica
# mais rápido com cache de rankings e configurações.
REDIS_URL="rediss://default:senha@host:6379"

# Forçar uso dos arquivos KM/ em vez do banco (padrão: false).
# Só ative em desenvolvimento local sem Postgres.
COBERTURA_USE_KML_FILES="false"

# Credenciais do admin do dashboard.
# Crie o usuário rodando localmente ou na Vercel com:
#   npx tsx scripts/create-admin.js
ADMIN_EMAIL="admin@melhorpreco.net"
ADMIN_PASSWORD="mude_esta_senha_antes_de_subir"
